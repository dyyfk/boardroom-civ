# Optional. If unset, the app falls back to a deterministic offline simulator
# so the demo still runs without network access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
BOARDROOM_API_PORT=5181

# cognee sidecar — Python FastAPI service that backs the Living Wiki with a real
# knowledge graph. Reuses ANTHROPIC_API_KEY above. fastembed handles embeddings
# locally, so no second key is required.
COGNEE_SIDECAR_URL=http://127.0.0.1:5182
COGNEE_SIDECAR_PORT=5182
COGNEE_LLM_MODEL=claude-haiku-4-5-20251001
